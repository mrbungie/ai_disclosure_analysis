# Optional: Tiingo fallback for delisted tickers in
# scripts/03_market_data/01_collect_market_data.py (free key at tiingo.com)
TIINGO_API_KEY=

# OpenRouter — judge model for scripts/common/golden_set.py's paragraph
# labeling (one OpenAI-compatible key for any model family, get one at
# https://openrouter.ai/keys).
OPENROUTER_API_KEY=

# Backblaze B2 — used by scripts/common/sync_data_b2.sh to mirror data/ to a
# cheap off-machine bucket. Create an Application Key scoped to one bucket at
# https://secure.backblaze.com/app_keys.htm (needs the master/bucket key ID,
# NOT the key's display name).
B2_KEY_ID=
B2_APPLICATION_KEY=
# Name of the B2 bucket the key is scoped to.
B2_BUCKET=
# Path prefix inside the bucket to mirror data/ under (leave empty to mirror
# straight into the bucket root).
B2_PREFIX=ai-disclosure-analysis
# Local name for the rclone remote the script wires up from the vars above
# (no rclone.conf entry needed — it's injected via RCLONE_CONFIG_* env vars).
RCLONE_REMOTE_NAME=b2thesis

# Hugging Face — used by scripts/common/hf_sync.py to mirror data/ and models/
HF_TOKEN=your_huggingface_token_here
HF_REPO=mrbungie/ai-disclosure-analysis
# Optional: override specific dataset or model repo IDs if they differ
# HF_DATASET_REPO=mrbungie/ai-disclosure-analysis
# HF_MODEL_REPO=mrbungie/ai-disclosure-analysis

# Optional: voluntary earnings call transcript gap-fill providers (03_fill_gaps_eq.py, 04_fill_gaps_sa.py)
EQ_MCP_URL=
EQ_API_KEY=
SA_BASE_URL=
