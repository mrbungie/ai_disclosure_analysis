# Optional: Tiingo fallback for delisted tickers in
# scripts/03_market_data/01_collect_market_data.py (free key at tiingo.com)
TIINGO_API_KEY=

# Backblaze B2 — used by scripts/common/sync_data_b2.sh to mirror data/ to a
# cheap off-machine bucket. Create an Application Key scoped to one bucket at
# https://secure.backblaze.com/app_keys.htm (needs the master/bucket key ID,
# NOT the key's display name).
B2_KEY_ID=
B2_APPLICATION_KEY=
# Name of the B2 bucket the key is scoped to.
B2_BUCKET=
# Path prefix inside the bucket to mirror data/ under (leave empty to mirror
# straight into the bucket root).
B2_PREFIX=stock-analysis
# Local name for the rclone remote the script wires up from the vars above
# (no rclone.conf entry needed — it's injected via RCLONE_CONFIG_* env vars).
RCLONE_REMOTE_NAME=b2thesis
