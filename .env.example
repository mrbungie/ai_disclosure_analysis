# Independent LLM judge used by scripts/build_eval_set.py --label (both
# stages) — should be a different model family from anything the harness
# candidates approximate, so it isn't grading a close relative of itself.
#
# LLM_JUDGE_PROVIDER=google routes through the Gemini API (GOOGLE_API_KEY,
# LLM_JUDGE_MODEL e.g. gemini-3.1-flash-lite). Any other value (or unset)
# uses an OpenAI-compatible endpoint (LLM_JUDGE_API_KEY/BASE_URL/MODEL) —
# this is how NVIDIA NIM models are reached. See harness_fit.build_judge().
LLM_JUDGE_PROVIDER=google
GOOGLE_API_KEY=
LLM_JUDGE_MODEL=gemini-3.1-flash-lite
LLM_JUDGE_API_KEY=
LLM_JUDGE_BASE_URL=https://api.openai.com/v1

# Optional: Tiingo fallback for delisted tickers in scripts/13_collect_market_data.py (free key at tiingo.com)
TIINGO_API_KEY=
